# fn2 skill — optional .env for CI / containers.
# Prefer `fn2 login` (stores the key 0600 in ~/.config/fn2). Use this file only
# when an environment file is more convenient, and keep it out of version
# control (it is already in .gitignore).

# Your personal fn2 API key (needs the 'agents' scope). Shown once at creation.
FN2_API_KEY=fn2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override the endpoint (default https://fn2.ai).
# FN2_BASE_URL=https://fn2.ai

# Override the onboarding link printed by `fn2 login`.
# FN2_ONBOARD_URL=https://fn2.ai/skill
