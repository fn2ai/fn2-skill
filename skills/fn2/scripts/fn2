#!/usr/bin/env python3
"""Entry point for the fn2 skill.

Resolves the bundled ``fn2cli`` package next to this file so the skill runs the
same way whether it was copied, symlinked, or invoked by absolute path from any
of Claude Code, Codex, or Pi. Standard library only — no install step.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from fn2cli.cli import main  # noqa: E402  (after sys.path setup)

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
